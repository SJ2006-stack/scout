PORT=8787
CACHE_TTL_MS=60000
CONNECTOR_TIMEOUT_MS=8000
DEMO_STEP_MS=400
GEOCODER_TIMEOUT_MS=8000
NOMINATIM_USER_AGENT=GroceryScout/0.1 (personal grocery prototype)
GOOGLE_MAPS_API_KEY=
# BookMyShow listings through Pomerado. Leave empty to skip that source.
POMERADO_API_KEY=
# Claude Haiku 5.5 talks in event chat and calls Luma, District, and BookMyShow. Leave empty to use the keyword parser.
ANTHROPIC_API_KEY=
# Published page calls the HTTPS tunnel to the API on this Mac. Leave empty while the page and API share one local server.
VITE_API_BASE=
# Pins this process to one site: main, event, travel, food, shop, home, or appointments.
# Leave empty on localhost to work on Event Scout. Each Azure app sets its own value.
SCOUT_AGENT=
# Browser worker. Leave disabled until Chromium is installed. See docs/browser-worker.md.
BROWSER_WORKER_ENABLED=0
# Comma-separated hostnames. example.com also allows its subdomains. No scheme or path.
BROWSER_ALLOW_HOSTS=
BROWSER_OP_TIMEOUT_MS=15000
BROWSER_SESSION_TTL_MS=900000
BROWSER_MAX_SESSIONS=4
# Empty uses scout/.data/browser. That directory is gitignored and must not be committed.
BROWSER_STATE_DIR=
