PORT=8787
CACHE_TTL_MS=60000
# Successful event listings stay for 10 minutes. A failed source is not cached. Price checks keep CACHE_TTL_MS.
LISTING_CACHE_TTL_MS=600000
CONNECTOR_TIMEOUT_MS=8000
DEMO_STEP_MS=400
GEOCODER_TIMEOUT_MS=8000
NOMINATIM_USER_AGENT=GroceryScout/0.1 (personal grocery prototype)
GOOGLE_MAPS_API_KEY=
# BookMyShow listings through Pomerado. Leave empty to skip that source.
POMERADO_API_KEY=
# Claude Haiku 5.5 talks in event chat, calls Luma, District, and BookMyShow, and reads text from an attached image. Leave empty to use the keyword parser and leave attachments unread.
ANTHROPIC_API_KEY=
# Sarvam speech in and speech out. Leave empty and the mic stays quiet.
SARVAM_API_KEY=
# Published page calls the HTTPS tunnel to the API on this Mac. Leave empty while the page and API share one local server.
VITE_API_BASE=
# Pins this process to one site: main, event, travel, food, shop, home, or appointments.
# Leave empty on localhost to work on Event Scout. Each Azure app sets its own value.
SCOUT_AGENT=
# Browser worker. Leave disabled until Chromium is installed. See docs/browser-worker.md.
# Public https sites can be opened on this machine. Private, link-local, and metadata hosts stay closed.
# Cleartext page requests, including images, stay closed. The separate Chromium process requires an allowlist.
BROWSER_WORKER_ENABLED=0
BROWSER_HEADED=0
BROWSER_OP_TIMEOUT_MS=15000
BROWSER_SESSION_TTL_MS=900000
BROWSER_PROFILE_TTL_MS=604800000
# 64 hex characters. Empty keeps every session ephemeral. Never commit the real key.
# The dedicated browser process refuses to start until this key is set.
BROWSER_PROFILE_KEY=
# Comma-separated public hosts. Empty on this machine allows any public https site.
# Example for the dedicated process: luma.com,district.in,bookmyshow.com
BROWSER_ALLOWED_HOSTS=
BROWSER_MAX_SESSIONS=4
# Empty uses scout/.data/browser. That directory is gitignored and must not be committed.
BROWSER_STATE_DIR=
# Central browser on one P1v3. Leave both empty on this machine so Playwright stays local.
# A site app sets BROWSER_RUNTIME_URL and leaves BROWSER_WORKER_ENABLED=0.
# The SCOUT_ROLE=browser process sets BROWSER_RUNTIME_KEY and leaves the URL empty.
BROWSER_RUNTIME_URL=
BROWSER_RUNTIME_KEY=
# Admission for the shared Chromium. Empty keeps the defaults: global 2 (max 4), one session per user, one per site.
BROWSER_GLOBAL_LIMIT=
BROWSER_USER_LIMIT=
BROWSER_DOMAIN_LIMIT=
# Planning ceiling in MB. A measured RSS of 0 is unknown and is not refused.
BROWSER_RSS_CEILING_MB=
# Close an open session that has been idle this long. Empty keeps only the session TTL. Paused sessions stay until TTL.
BROWSER_IDLE_MS=
# Users and the browser session attached to each one. Empty uses scout/.data/scout.sqlite.
# On Azure App Service the file is /home/data/scout.sqlite, the disk that comes with the plan.
# Saved sign-in cookies stay in the encrypted profile, not in this file.
SCOUT_DB_PATH=
# Email sign-in. The code is sent from this AgentMail inbox. Leave both empty and sign-in cannot send.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
# Firebase App Distribution. The landing invite adds this address as a tester and Firebase emails the install link.
# Leave either empty and the invite form cannot send. Never commit the private key.
FIREBASE_DISTRIBUTION_CLIENT_EMAIL=
FIREBASE_DISTRIBUTION_PRIVATE_KEY=
# Phone push for Scout Watch. Empty falls back to the FIREBASE_DISTRIBUTION_* service account and project scout-b4da3.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Bolna voice calls. BOLNA_API_KEY is the bn- key from the Bolna dashboard.
# BOLNA_LLM_KEY is a random secret (openssl rand -hex 32) that Bolna sends when it calls /api/bolna/v1; it also signs voice tickets.
# BOLNA_AGENT_ID comes from npm run bolna:setup -- <this site's https origin>. One agent per site. Leave all empty to hide voice calls.
BOLNA_API_KEY=
BOLNA_LLM_KEY=
BOLNA_AGENT_ID=
